# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (Postgres) ---
# Local dev example: postgresql://bingwa:change_me@localhost:5432/bingwa_teke
# Render/Railway: they give you this connection string automatically —
# paste it here for local dev, and set it as an env var on the host for prod.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# --- Safaricom Daraja (M-Pesa) ---
# Get these from https://developer.safaricom.co.ke after creating an app.
# Use "sandbox" while testing, "production" once Safaricom approves you
# for a real Paybill/Till (go-live application).
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_consumer_key
DARAJA_CONSUMER_SECRET=your_consumer_secret
# Sandbox default test shortcode is 174379 — use your real Paybill/Till in production.
DARAJA_SHORTCODE=174379
# Sandbox default test passkey is published on the Daraja docs; use your own in production.
DARAJA_PASSKEY=your_passkey
# Must be a public HTTPS URL Safaricom can reach — your deployed backend's
# /api/mpesa/callback route, e.g. https://bingwa-teke.onrender.com/api/mpesa/callback
DARAJA_CALLBACK_URL=https://your-backend-domain.example.com/api/mpesa/callback
